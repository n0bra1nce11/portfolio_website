---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  summary: string;
  date: Date;
  tags: string[];
  resourceUrl?: string;
}

const { title, summary, date, tags, resourceUrl } = Astro.props;
const formattedDate = date.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={summary}>
  <article class="container prose post">
    <p class="mono post-eyebrow"><a href="/writing/">Writing</a></p>
    <h1>{title}</h1>
    <p class="mono post-meta">
      {formattedDate}
      {tags.length > 0 && <> · {tags.join(' · ')}</>}
    </p>

    {
      resourceUrl && (
        <p class="post-resource">
          <a href={resourceUrl} class="button button-primary">Download resource</a>
        </p>
      )
    }

    <div class="post-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .post-eyebrow {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
  }

  .post-meta {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-3);
  }

  .post-resource {
    margin-block: var(--space-3);
  }

  .button {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    text-decoration: none;
    padding: 0.6rem 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    color: var(--fg);
  }

  .button-primary {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .post-body {
    padding-block: var(--space-3) var(--space-6);
  }
</style>
