---
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';
import '@/styles/print.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title === 'Aayush Shrestha' ? title : `${title} — Aayush Shrestha`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />

    <!--
      Theme init: applies a persisted theme choice before the rest of the
      page renders. Bundled as an external module (no inline script) so the
      site's CSP can ship without 'unsafe-inline'. Astro's default preference
      is honoured via CSS (prefers-color-scheme) until a user picks explicitly.
    -->
    <script>
      const STORAGE_KEY = 'theme';
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved === 'dark' || saved === 'light') {
        document.documentElement.setAttribute('data-theme', saved);
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
