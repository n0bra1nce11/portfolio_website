---
import { nav, site } from '@/lib/site';

const { pathname } = Astro.url;
---

<nav class="site-nav" aria-label="Primary">
  <div class="container site-nav-inner">
    <a href="/" class="site-nav-brand mono">{site.name}</a>
    <button class="mobile-nav-toggle" aria-expanded="false" aria-controls="primary-nav-list">
      <span class="sr-only">Menu</span>
      <span aria-hidden="true">☰</span>
    </button>
    <ul id="primary-nav-list" class="site-nav-list">
      {
        nav.map((item) => {
          const isActive =
            item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
          return (
            <li>
              <a href={item.href} aria-current={isActive ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          );
        })
      }
      <li>
        <a href={site.cvPath} class="site-nav-cv mono">Download CV</a>
      </li>
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .site-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
    gap: var(--space-3);
  }

  .site-nav-brand {
    font-size: var(--fs-base);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }

  .site-nav-list a {
    text-decoration: none;
    color: var(--fg-muted);
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .site-nav-list a:hover {
    color: var(--fg);
  }

  .site-nav-list a[aria-current='page'] {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  .site-nav-cv {
    color: var(--fg) !important;
    border: 1px solid var(--rule-strong);
    padding: 0.35rem 0.6rem !important;
    border-radius: var(--radius);
  }

  .site-nav-cv:hover {
    border-color: var(--fg);
  }

  .mobile-nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--rule-strong);
    color: var(--fg);
    font-size: var(--fs-lg);
    line-height: 1;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .mobile-nav-toggle {
      display: block;
    }

    .site-nav-list {
      display: none;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      gap: var(--space-2);
      padding-block: var(--space-2);
    }

    .site-nav-list.is-open {
      display: flex;
    }

    .site-nav-inner {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
  const list = document.getElementById('primary-nav-list');

  toggle?.addEventListener('click', () => {
    const isOpen = list?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>
