---
// Severity is encoded by intensity of the single site accent, never by
// hue alone — the text label is always present so the encoding also
// works for colorblind readers and in monochrome print.
interface Props {
  level: 'critical' | 'high' | 'medium' | 'low' | 'info';
}

const { level } = Astro.props;

const labels: Record<Props['level'], string> = {
  critical: 'Critical',
  high: 'High',
  medium: 'Medium',
  low: 'Low',
  info: 'Info',
};
---

<span class:list={['severity-badge', `severity-${level}`]} class="mono">
  {labels[level]}
</span>

<style>
  .severity-badge {
    display: inline-block;
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.02em;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius);
    border: 1px solid var(--rule-strong);
    text-transform: uppercase;
  }

  .severity-critical {
    background: var(--accent);
    color: var(--accent-fg);
    border-color: var(--accent);
  }

  .severity-high {
    background: var(--accent-tint-40);
    color: var(--fg);
    border-color: var(--accent);
  }

  .severity-medium {
    background: var(--accent-tint-15);
    color: var(--fg);
    border-color: var(--accent);
  }

  .severity-low {
    background: transparent;
    color: var(--fg-muted);
    border-color: var(--rule-strong);
  }

  .severity-info {
    background: transparent;
    color: var(--fg-muted);
    border-style: dashed;
  }
</style>
