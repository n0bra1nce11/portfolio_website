---
export interface RiskRegisterRow {
  id: string;
  risk: string;
  likelihood: 'critical' | 'high' | 'medium' | 'low';
  impact: 'critical' | 'high' | 'medium' | 'low';
  owner: string;
  treatment: 'Mitigate' | 'Accept' | 'Transfer' | 'Avoid';
  targetDate: string;
}

interface Props {
  rows: RiskRegisterRow[];
  caption?: string;
}

const { rows, caption = 'Risk register extract' } = Astro.props;
---

<div class="table-scroll">
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">ID</th>
        <th scope="col">Risk</th>
        <th scope="col">Likelihood</th>
        <th scope="col">Impact</th>
        <th scope="col">Owner</th>
        <th scope="col">Treatment</th>
        <th scope="col">Target date</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td>{row.id}</td>
            <td>{row.risk}</td>
            <td>{row.likelihood}</td>
            <td>{row.impact}</td>
            <td>{row.owner}</td>
            <td>{row.treatment}</td>
            <td>{row.targetDate}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
