---
export interface ControlMappingRow {
  finding: string;
  controls: string;
  compensatingControl: string;
  residualRisk: 'critical' | 'high' | 'medium' | 'low' | 'info';
}

interface Props {
  rows: ControlMappingRow[];
  caption?: string;
}

const { rows, caption = 'Finding → ISO/IEC 27001:2022 Annex A control mapping' } = Astro.props;
---

<div class="table-scroll">
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Finding</th>
        <th scope="col">Violated Annex A control(s)</th>
        <th scope="col">Compensating control</th>
        <th scope="col">Residual risk</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td>{row.finding}</td>
            <td>{row.controls}</td>
            <td>{row.compensatingControl}</td>
            <td>{row.residualRisk}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
