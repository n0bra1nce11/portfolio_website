---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/lib/site';
import { slugify } from '@/lib/slug';

const featured = (await getCollection('work'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout
  title={site.name}
  description="Security consultant portfolio — penetration testing and GRC. I test controls the way an attacker would, then evidence them the way an auditor does."
>
  <section class="container hero">
    <p class="mono hero-eyebrow">{site.status} · {site.location}</p>
    <h1>{site.name}</h1>
    <p class="hero-role">{site.role}</p>

    <p class="hero-line">
      "I test controls the way an attacker would, then evidence them the way an auditor does."
    </p>

    <p class="hero-body">
      I break things to find out how they fail, then write down exactly which control failed,
      how bad it is, and what closes the gap — in language a pentest team and an audit committee
      can both act on.
    </p>

    <div class="hero-actions">
      <a href="/work/" class="button button-primary">See the work</a>
      <a href={`mailto:${site.email}`} class="button">Email me</a>
    </div>
  </section>

  <section class="container featured">
    <div class="featured-header">
      <h2>Featured work</h2>
      <a href="/work/" class="mono">All case studies →</a>
    </div>
    <ul class="featured-list">
      {
        featured.map((entry) => (
          <li>
            <a href={`/work/${slugify(entry.id)}/`}>
              <p class="mono featured-ref">{entry.data.refId}</p>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
  }

  .hero-eyebrow {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--space-2);
  }

  .hero h1 {
    margin-bottom: var(--space-1);
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    color: var(--fg-muted);
    margin-bottom: var(--space-4);
  }

  .hero-line {
    font-size: var(--fs-xl);
    font-style: italic;
    border-top: 1px solid var(--fg);
    border-bottom: 1px solid var(--fg);
    padding-block: var(--space-3);
    margin: 0 0 var(--space-3);
    max-width: 38rem;
  }

  .hero-body {
    max-width: 38rem;
    color: var(--fg-muted);
    font-size: var(--fs-lg);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .button {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    text-decoration: none;
    padding: 0.6rem 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    color: var(--fg);
  }

  .button:hover {
    border-color: var(--fg);
  }

  .button-primary {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .featured {
    padding-block: var(--space-5) var(--space-7);
    border-top: 1px solid var(--rule);
  }

  .featured-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .featured-header a {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  .featured-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .featured-list a {
    display: block;
    text-decoration: none;
    color: var(--fg);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: var(--space-3);
    height: 100%;
  }

  .featured-list a:hover {
    border-color: var(--fg);
  }

  .featured-ref {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    margin-bottom: var(--space-1);
  }

  .featured-list h3 {
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-1);
  }

  .featured-list p:not(.featured-ref) {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }
</style>
