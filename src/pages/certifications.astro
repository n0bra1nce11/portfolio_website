---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Certifications & Education"
  description="Certifications earned and in progress, plus academic background."
>
  <article class="container prose">
    <h1>Certifications &amp; Education</h1>

    <h2>Certifications</h2>
    <div class="callout">
      TODO — list earned certifications and in-progress ones with a target quarter (e.g.
      "OSCP — targeting Q2 2027"). Left blank rather than invented.
    </div>

    <div class="table-scroll cert-table">
      <table>
        <caption>Certifications</caption>
        <thead>
          <tr>
            <th scope="col">Certification</th>
            <th scope="col">Status</th>
            <th scope="col">Target / date</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="todo" colspan="3">TODO</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h2>Education</h2>

    <div class="edu-entry">
      <div class="edu-head">
        <h3>BSc (Hons) Ethical Hacking and Cybersecurity</h3>
        <p class="mono edu-dates">2023 – 2026</p>
      </div>
      <p class="mono edu-org">Softwarica College of IT and E-Commerce, Kathmandu, Bagmati</p>
      <p class="edu-status">Upper Class standing.</p>
    </div>

    <div class="edu-entry">
      <div class="edu-head">
        <h3>Cambridge A-Levels</h3>
        <p class="mono edu-dates">2020 – 2022</p>
      </div>
      <p class="mono edu-org">Saipal Academy, Dhumbaharai, Kathmandu</p>
    </div>
  </article>
</BaseLayout>

<style>
  .callout {
    border: 1px solid var(--rule-strong);
    border-left: 3px solid var(--accent);
    padding: var(--space-2) var(--space-3);
    margin-block: var(--space-3);
    font-size: var(--fs-sm);
  }

  .cert-table {
    margin-block: var(--space-3) var(--space-5);
  }

  .todo {
    color: var(--fg-muted);
  }

  .edu-entry {
    border-top: 1px solid var(--rule);
    padding-block: var(--space-3);
  }

  .edu-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .edu-head h3 {
    margin: 0;
    font-size: var(--fs-lg);
  }

  .edu-dates,
  .edu-org {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
  }

  .edu-status {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
</style>
