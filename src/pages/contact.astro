---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/lib/site';
---

<BaseLayout
  title="Contact"
  description="Plain contact links — email, LinkedIn, GitHub, CV. No contact form."
>
  <article class="container prose">
    <h1>Contact</h1>
    <p>
      No contact form — those can fail silently. Direct links only.
    </p>

    <dl class="contact-list mono">
      <div>
        <dt>Email</dt>
        <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      </div>
      <div>
        <dt>LinkedIn</dt>
        <dd><a href={site.linkedin} rel="me noopener noreferrer" target="_blank">{site.linkedin}</a></dd>
      </div>
      <div>
        <dt>GitHub</dt>
        <dd><a href={site.github} rel="me noopener noreferrer" target="_blank">{site.github}</a></dd>
      </div>
      <div>
        <dt>CV</dt>
        <dd><a href={site.cvPath}>Download CV (PDF)</a></dd>
      </div>
    </dl>

    <h2>PGP</h2>
    {
      site.pgpFingerprint ? (
        <>
          <p class="mono">Fingerprint: {site.pgpFingerprint}</p>
          <p><a href={site.pgpKeyPath}>Download public key</a></p>
        </>
      ) : (
        <div class="callout">
          TODO — publish a PGP public key here if you want encrypted contact, and reference the
          same key in <a href="/.well-known/security.txt">/.well-known/security.txt</a>. Left
          blank rather than fabricated.
        </div>
      )
    }
  </article>
</BaseLayout>

<style>
  .contact-list {
    margin-block: var(--space-3) var(--space-5);
  }

  .contact-list div {
    display: flex;
    gap: var(--space-2);
    border-top: 1px solid var(--rule);
    padding-block: var(--space-2);
    font-size: var(--fs-sm);
    flex-wrap: wrap;
  }

  .contact-list dt {
    color: var(--fg-muted);
    min-width: 6rem;
  }

  .contact-list dd {
    margin: 0;
    word-break: break-word;
  }

  .callout {
    border: 1px solid var(--rule-strong);
    border-left: 3px solid var(--accent);
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-sm);
  }
</style>
