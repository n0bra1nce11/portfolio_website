---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/lib/site';
---

<BaseLayout
  title="About"
  description="Security consultant working toward penetration testing and GRC — what I do, what I'm aiming at, and the toolkit I use."
>
  <article class="container prose">
    <h1>About</h1>

    <p>
      I'm {site.name}, a {site.status.toLowerCase()} based in {site.location}. I work at the
      intersection of offensive testing and governance/compliance: finding out whether a control
      actually holds up under pressure, then writing that finding up in a form an auditor can
      act on — mapped to a framework, not just a CVSS score.
    </p>

    <p>
      TODO — one or two lines of personality/voice here (what got you into this, what you do
      outside of it, anything that makes the page sound like a person and not a CV).
    </p>

    <p>
      Education: {' '}
      <a href="/certifications/">certifications and education are on their own page</a>.
    </p>

    <h2>Toolkit</h2>
    <p>
      Grouped by function — no proficiency bars, because "73% skilled in Nmap" isn't a
      meaningful claim to anyone hiring for this work.
    </p>

    <div class="toolkit-grid">
      <div class="toolkit-group">
        <h3 class="mono">Offensive</h3>
        <ul class="mono">
          <li>Burp Suite</li>
          <li>Nmap</li>
          <li>Metasploit</li>
          <li>Nessus</li>
          <li>OWASP WSTG methodology</li>
          <li>PTES methodology</li>
        </ul>
      </div>
      <div class="toolkit-group">
        <h3 class="mono">Defensive</h3>
        <ul class="mono">
          <li>Wazuh</li>
          <li>Suricata</li>
          <li>MITRE ATT&amp;CK mapping</li>
        </ul>
      </div>
      <div class="toolkit-group">
        <h3 class="mono">Governance / GRC</h3>
        <ul class="mono">
          <li>ISO/IEC 27001</li>
          <li>NIST CSF</li>
          <li>Risk assessment</li>
          <li>Gap analysis</li>
          <li>Statement of Applicability</li>
        </ul>
      </div>
      <div class="toolkit-group">
        <h3 class="mono">Languages</h3>
        <ul class="mono">
          <li>Python</li>
          <li>Bash</li>
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .toolkit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-4);
    margin-block: var(--space-3) var(--space-5);
  }

  .toolkit-group h3 {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-1);
    margin-bottom: var(--space-1);
  }

  .toolkit-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-sm);
  }

  .toolkit-group li {
    padding-block: 0.2rem;
  }
</style>
