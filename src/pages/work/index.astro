---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SeverityBadge from '@/components/SeverityBadge.astro';
import { slugify } from '@/lib/slug';

const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Work"
  description="Case studies: VAPT, detection engineering, SIEM, and network builds — each mapped to methodology and, where applicable, ISO 27001 Annex A controls."
>
  <div class="container">
    <header class="page-header prose">
      <h1>Work</h1>
      <p>
        Case studies from lab and personal projects, written in the same format I'd use for a
        client deliverable: scope, methodology, findings, control mapping, and an executive
        summary. Client engagement details are confidential under NDA — see
        <a href="/experience/">Experience</a>.
      </p>
    </header>

    <ul class="work-index">
      {
        entries.map((entry) => (
          <li class="work-card">
            <a href={`/work/${slugify(entry.id)}/`} class="work-card-link">
              <div class="work-card-head">
                <p class="mono work-card-ref">{entry.data.refId}</p>
                <span class="mono work-card-status" data-status={entry.data.status}>
                  {entry.data.status}
                </span>
              </div>
              <h2>{entry.data.title}</h2>
              <p class="work-card-summary">{entry.data.summary}</p>
              <div class="work-card-meta">
                {entry.data.headlineSeverity && <SeverityBadge level={entry.data.headlineSeverity} />}
                <span class="mono work-card-tags">{entry.data.tags.join(' · ')}</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-block: var(--space-4) 0;
  }

  .work-index {
    list-style: none;
    margin: var(--space-4) 0 var(--space-6);
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .work-card {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .work-card-link {
    display: block;
    padding: var(--space-3);
    text-decoration: none;
    color: var(--fg);
  }

  .work-card-link:hover {
    border-color: var(--fg);
  }

  .work-card:has(.work-card-link:hover) {
    border-color: var(--fg);
  }

  .work-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }

  .work-card-status {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    padding: 0.1rem 0.5rem;
  }

  .work-card h2 {
    font-size: var(--fs-lg);
    margin: var(--space-1) 0;
  }

  .work-card-summary {
    color: var(--fg-muted);
    margin-bottom: var(--space-2);
  }

  .work-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
</style>
